rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth!=null;}
  function platformAdmin(){return signed()&&request.auth.token.firebase.sign_in_provider!='anonymous'&&exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid))&&get(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)).data.enabled==true;}
  match /platformAdmins/{uid}{allow get: if signed()&&request.auth.uid==uid;allow list,write: if false;}
  function guest(){return signed()&&request.auth.token.firebase.sign_in_provider=='anonymous';}
  function account(rid){return signed()&&!guest()&&request.auth.uid==rid&&get(/databases/$(database)/documents/restaurants/$(rid)).data.ownerUid==request.auth.uid;}
  function owner(rid){return account(rid)&&get(/databases/$(database)/documents/clients/$(rid)).data.approved==true;}
  match /clients/{rid}{
   allow get: if platformAdmin()||(signed()&&!guest()&&request.auth.uid==rid);
   allow list: if platformAdmin();
   function details(d){return d.clientName is string&&d.clientName.size()>0&&d.clientName.size()<=100
    &&d.phone is string&&d.phone.matches('^[+0-9 ()-]{7,25}$')
    &&d.address is string&&d.address.size()>0&&d.address.size()<=500
    &&d.location is string&&d.location.size()>0&&d.location.size()<=200;}
   allow create: if account(rid)&&details(request.resource.data)
    &&request.resource.data.keys().hasOnly(['clientName','phone','address','location','approved','reviewPending','createdAt','updatedAt'])
    &&request.resource.data.approved==false&&request.resource.data.reviewPending==true
    &&request.resource.data.createdAt==request.time&&request.resource.data.updatedAt==request.time;
   allow update: if (account(rid)&&details(request.resource.data)
    &&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clientName','phone','address','location','reviewPending','updatedAt'])
    &&request.resource.data.reviewPending==true&&request.resource.data.updatedAt==request.time)
    ||(platformAdmin()&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved','reviewPending','reviewedAt'])
    &&request.resource.data.approved is bool&&request.resource.data.reviewPending==false&&request.resource.data.reviewedAt==request.time);
  }
  function tableValid(t){return t is string&&t.matches('^[a-zA-Z0-9-]{1,12}$');}
  function validSession(rid,d){let t=get(/databases/$(database)/documents/restaurants/$(rid)/tables/$(d.tableNumber)).data;return guest()&&t.guestUid==request.auth.uid&&t.sessionId==d.sessionId;}
  function line(rid,x,addon){let m=get(/databases/$(database)/documents/restaurants/$(rid)/menuItems/$(x.itemId)).data;return x.keys().hasOnly(['itemId','name','price','type','qty','addedAt','isAddon'])&&m.available==true&&x.name==m.name&&x.price==m.price&&x.type==m.type&&x.qty is int&&x.qty>0&&x.qty<=99&&x.addedAt is number&&x.isAddon==addon;}
  function lines(rid,l,addon){return l is list&&l.size()>0&&l.size()<=6&&line(rid,l[0],addon)&&(l.size()<2||line(rid,l[1],addon))&&(l.size()<3||line(rid,l[2],addon))&&(l.size()<4||line(rid,l[3],addon))&&(l.size()<5||line(rid,l[4],addon))&&(l.size()<6||line(rid,l[5],addon));}
  function amount(l,i){return l.size()>i?l[i].qty*l[i].price:0;}
  function sum(l){return amount(l,0)+amount(l,1)+amount(l,2)+amount(l,3)+amount(l,4)+amount(l,5);}
  function locked(rid,oid,d){let t=getAfter(/databases/$(database)/documents/restaurants/$(rid)/tables/$(d.tableNumber)).data;return t.orderId==oid&&t.guestUid==request.auth.uid&&t.sessionId==d.sessionId;}
  match /orderViews/{oid}{
   allow get: if true;
   allow list,delete: if false;
   function validView(){
    let d=request.resource.data;
    let o=getAfter(/databases/$(database)/documents/restaurants/$(d.restaurantId)/orders/$(oid)).data;
    return d.keys().hasOnly(['restaurantId','restaurantName','tableNumber','status','items','total'])
     &&(owner(d.restaurantId)||(guest()&&o.guestUid==request.auth.uid))
     &&d.restaurantName is string&&d.tableNumber==o.tableNumber&&d.status==o.status&&d.items==o.items&&d.total==o.total;
   }
   allow create: if validView()&&request.resource.data.restaurantName==get(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantId)).data.name;
   allow update: if validView()&&request.resource.data.restaurantId==resource.data.restaurantId&&request.resource.data.restaurantName==resource.data.restaurantName;
  }
  match /restaurants/{rid}{
   allow get: if true;allow list: if platformAdmin();
   allow create: if signed()&&!guest()&&rid==request.auth.uid&&request.resource.data.keys().hasOnly(['name','ownerUid','logoUrl','bannerImages','features','createdAt'])&&request.resource.data.ownerUid==request.auth.uid&&request.resource.data.name is string&&request.resource.data.name.size()>0&&request.resource.data.name.size()<=100;
   allow update: if owner(rid)&&request.resource.data.ownerUid==resource.data.ownerUid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','logoUrl','bannerImages','features'])&&request.resource.data.name is string&&request.resource.data.name.size()>0&&request.resource.data.name.size()<=100&&request.resource.data.bannerImages.size()<=8
    &&(request.resource.data.name==resource.data.name||(getAfter(/databases/$(database)/documents/clients/$(rid)).data.reviewPending==true&&getAfter(/databases/$(database)/documents/clients/$(rid)).data.updatedAt==request.time));
   match /categories/{id}{allow read: if true;allow create,update: if owner(rid)&&request.resource.data.name is string&&request.resource.data.name.size()>0&&request.resource.data.name.size()<=60;allow delete: if owner(rid);}
   match /menuItems/{id}{allow read: if true;allow create,update: if owner(rid)&&request.resource.data.name is string&&request.resource.data.name.size()>0&&request.resource.data.price is number&&request.resource.data.price>=0&&request.resource.data.images is list&&request.resource.data.images.size()<=3&&request.resource.data.type in ['veg','nonveg']&&request.resource.data.available is bool&&request.resource.data.categoryIds is list;allow delete: if owner(rid);}
   match /tableConfigs/{table}{allow get: if true;allow list: if owner(rid);allow create,update: if owner(rid)&&tableValid(table)&&request.resource.data.keys().hasOnly(['tableNumber','updatedAt'])&&request.resource.data.tableNumber==table&&request.resource.data.updatedAt==request.time;}
   match /tableOccupancy/{table}{
    allow get: if signed();allow list: if owner(rid);
    allow create: if owner(rid)&&request.resource.data.keys().hasOnly(['guestUid','sessionId'])&&getAfter(/databases/$(database)/documents/restaurants/$(rid)/tables/$(table)).data.guestUid==request.resource.data.guestUid&&getAfter(/databases/$(database)/documents/restaurants/$(rid)/tables/$(table)).data.sessionId==request.resource.data.sessionId;
    allow delete: if owner(rid);
   }
   match /tables/{table}{
    allow get: if owner(rid)||(guest()&&(!exists(/databases/$(database)/documents/restaurants/$(rid)/tables/$(table))||resource.data.guestUid==request.auth.uid));allow list: if owner(rid);
    allow create: if owner(rid)&&tableValid(table)&&exists(/databases/$(database)/documents/restaurants/$(rid)/tableConfigs/$(table))
     &&request.resource.data.keys().hasOnly(['tableNumber','sessionId','guestUid','orderId','createdAt'])&&request.resource.data.tableNumber==table&&request.resource.data.sessionId is string&&request.resource.data.orderId==null&&request.resource.data.createdAt==request.time
     &&getAfter(/databases/$(database)/documents/restaurants/$(rid)/tableJoinRequests/$(table+'_'+request.resource.data.guestUid)).data.status=='approved'
     &&getAfter(/databases/$(database)/documents/restaurants/$(rid)/tableJoinRequests/$(table+'_'+request.resource.data.guestUid)).data.sessionId==request.resource.data.sessionId
     &&getAfter(/databases/$(database)/documents/restaurants/$(rid)/tableOccupancy/$(table)).data.sessionId==request.resource.data.sessionId;
    allow update: if guest()&&resource.data.guestUid==request.auth.uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orderId'])&&(resource.data.orderId==null||request.resource.data.orderId==resource.data.orderId)
     &&getAfter(/databases/$(database)/documents/restaurants/$(rid)/orders/$(request.resource.data.orderId)).data.guestUid==request.auth.uid
     &&getAfter(/databases/$(database)/documents/restaurants/$(rid)/orders/$(request.resource.data.orderId)).data.tableNumber==table
     &&getAfter(/databases/$(database)/documents/restaurants/$(rid)/orders/$(request.resource.data.orderId)).data.sessionId==resource.data.sessionId
     &&getAfter(/databases/$(database)/documents/restaurants/$(rid)/orders/$(request.resource.data.orderId)).data.status=='pending';
    allow delete: if owner(rid);
   }
   match /tableJoinRequests/{id}{
    allow get: if owner(rid)||(guest()&&id.matches('^.*_'+request.auth.uid+'$'));allow list: if owner(rid);
    function validJoin(){let d=request.resource.data;return guest()&&id==d.tableNumber+'_'+request.auth.uid&&d.keys().hasOnly(['tableNumber','sessionId','guestUid','status','updatedAt'])&&tableValid(d.tableNumber)&&d.guestUid==request.auth.uid&&d.status=='pending'&&d.sessionId is string&&d.sessionId.size()>=20&&d.sessionId.size()<=64&&d.updatedAt==request.time&&exists(/databases/$(database)/documents/restaurants/$(rid)/tableConfigs/$(d.tableNumber))&&!exists(/databases/$(database)/documents/restaurants/$(rid)/tableOccupancy/$(d.tableNumber));}
    allow create: if validJoin();
    allow update: if(owner(rid)&&resource.data.status=='pending'&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])&&request.resource.data.status in ['approved','rejected'])||(validJoin()&&request.time>=resource.data.updatedAt+duration.value(60,'s'));
   }
   match /orders/{oid}{
    allow read: if platformAdmin()||owner(rid)||(signed()&&resource.data.guestUid==request.auth.uid);
    allow create: if guest()&&validSession(rid,request.resource.data)&&request.resource.data.keys().hasOnly(['guestUid','sessionId','trackingAvailable','tableNumber','status','items','addedItems','total','createdAt','updatedAt'])&&request.resource.data.guestUid==request.auth.uid&&tableValid(request.resource.data.tableNumber)&&request.resource.data.status=='pending'&&request.resource.data.createdAt==request.time&&request.resource.data.updatedAt==request.time&&request.resource.data.items==request.resource.data.addedItems&&lines(rid,request.resource.data.addedItems,false)&&request.resource.data.total==sum(request.resource.data.addedItems)&&locked(rid,oid,request.resource.data);
    allow update: if owner(rid)||(guest()&&validSession(rid,request.resource.data)&&resource.data.guestUid==request.auth.uid&&resource.data.status=='pending'&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['items','addedItems','total','updatedAt'])&&request.resource.data.updatedAt==request.time&&request.resource.data.items.size()<=200&&request.resource.data.items==resource.data.items.concat(request.resource.data.addedItems)&&lines(rid,request.resource.data.addedItems,true)&&request.resource.data.total==resource.data.total+sum(request.resource.data.addedItems)&&locked(rid,oid,request.resource.data));
   }
   match /requests/{id}{
    allow get: if owner(rid)||(guest()&&(!exists(/databases/$(database)/documents/restaurants/$(rid)/requests/$(id))||resource.data.guestUid==request.auth.uid));allow list: if owner(rid)||(guest()&&resource.data.guestUid==request.auth.uid);
    function validRequest(){let d=request.resource.data;return guest()&&validSession(rid,d)&&d.keys().hasOnly(['orderId','guestUid','sessionId','tableNumber','featureId','featureIcon','label','status','createdAt'])&&d.guestUid==request.auth.uid&&tableValid(d.tableNumber)&&id==d.tableNumber+'_'+request.auth.uid+'_'+d.featureId&&d.status=='open'&&d.createdAt==request.time&&d.label is string&&d.label.size()<=100&&{'id':d.featureId,'label':d.label,'icon':d.featureIcon,'enabled':true} in get(/databases/$(database)/documents/restaurants/$(rid)).data.features&&getAfter(/databases/$(database)/documents/restaurants/$(rid)/serviceLocks/$(d.tableNumber+'_'+d.featureId)).data.requestId==id&&(d.orderId==null||(get(/databases/$(database)/documents/restaurants/$(rid)/orders/$(d.orderId)).data.guestUid==request.auth.uid&&get(/databases/$(database)/documents/restaurants/$(rid)/orders/$(d.orderId)).data.status=='pending'));}
    allow create: if validRequest();allow update: if(owner(rid)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])&&request.resource.data.status=='done')||(resource.data.status=='done'&&validRequest());
   }
   match /serviceLocks/{id}{
    allow get: if signed();allow list: if owner(rid);
    allow create: if guest()&&request.resource.data.keys().hasOnly(['guestUid','requestId'])&&request.resource.data.guestUid==request.auth.uid&&id==getAfter(/databases/$(database)/documents/restaurants/$(rid)/requests/$(request.resource.data.requestId)).data.tableNumber+'_'+getAfter(/databases/$(database)/documents/restaurants/$(rid)/requests/$(request.resource.data.requestId)).data.featureId&&getAfter(/databases/$(database)/documents/restaurants/$(rid)/requests/$(request.resource.data.requestId)).data.guestUid==request.auth.uid&&getAfter(/databases/$(database)/documents/restaurants/$(rid)/requests/$(request.resource.data.requestId)).data.createdAt==request.time;
    allow delete: if owner(rid);
   }
   match /tableConflicts/{id}{
    allow get: if owner(rid)||(guest()&&id.matches('^.*_'+request.auth.uid+'$'));allow list: if owner(rid);
    function validConflict(){let d=request.resource.data;let occupied=get(/databases/$(database)/documents/restaurants/$(rid)/tableOccupancy/$(d.tableNumber)).data;return guest()&&d.keys().hasOnly(['tableNumber','guestUid','occupantSessionId','updatedAt'])&&id==d.tableNumber+'_'+request.auth.uid&&d.guestUid==request.auth.uid&&tableValid(d.tableNumber)&&d.updatedAt==request.time&&d.occupantSessionId==occupied.sessionId&&occupied.guestUid!=request.auth.uid;}
    allow create: if validConflict();allow update: if validConflict()&&request.time>=resource.data.updatedAt+duration.value(60,'s');
   }
   match /notifications/{id}{
    allow read: if owner(rid);
    function linked(){let d=request.resource.data;return d.type=='table_join'
     ?getAfter(/databases/$(database)/documents/restaurants/$(rid)/tableJoinRequests/$(d.joinId)).data.guestUid==request.auth.uid&&getAfter(/databases/$(database)/documents/restaurants/$(rid)/tableJoinRequests/$(d.joinId)).data.updatedAt==request.time&&getAfter(/databases/$(database)/documents/restaurants/$(rid)/tableJoinRequests/$(d.joinId)).data.status=='pending'&&getAfter(/databases/$(database)/documents/restaurants/$(rid)/tableJoinRequests/$(d.joinId)).data.tableNumber==d.tableNumber&&getAfter(/databases/$(database)/documents/restaurants/$(rid)/tableJoinRequests/$(d.joinId)).data.sessionId==d.sessionId
     :d.type=='table_conflict'?getAfter(/databases/$(database)/documents/restaurants/$(rid)/tableConflicts/$(d.conflictId)).data.guestUid==request.auth.uid&&getAfter(/databases/$(database)/documents/restaurants/$(rid)/tableConflicts/$(d.conflictId)).data.updatedAt==request.time&&getAfter(/databases/$(database)/documents/restaurants/$(rid)/tableConflicts/$(d.conflictId)).data.tableNumber==d.tableNumber&&getAfter(/databases/$(database)/documents/restaurants/$(rid)/tableConflicts/$(d.conflictId)).data.occupantSessionId==d.occupantSessionId
     :d.type=='request'?getAfter(/databases/$(database)/documents/restaurants/$(rid)/requests/$(d.requestId)).data.guestUid==request.auth.uid&&getAfter(/databases/$(database)/documents/restaurants/$(rid)/requests/$(d.requestId)).data.createdAt==request.time&&getAfter(/databases/$(database)/documents/restaurants/$(rid)/requests/$(d.requestId)).data.tableNumber==d.tableNumber
     :getAfter(/databases/$(database)/documents/restaurants/$(rid)/orders/$(d.orderId)).data.guestUid==request.auth.uid&&getAfter(/databases/$(database)/documents/restaurants/$(rid)/orders/$(d.orderId)).data.updatedAt==request.time&&getAfter(/databases/$(database)/documents/restaurants/$(rid)/orders/$(d.orderId)).data.tableNumber==d.tableNumber;}
    allow create: if guest()&&request.resource.data.keys().hasOnly(['type','requestId','orderId','joinId','sessionId','guestUid','conflictId','occupantSessionId','tableNumber','message','read','createdAt'])&&request.resource.data.guestUid==request.auth.uid&&request.resource.data.type in ['new_order','items_added','request','table_conflict','table_join']&&request.resource.data.read==false&&request.resource.data.createdAt==request.time&&request.resource.data.message is string&&request.resource.data.message.size()<=150&&linked();
    allow update: if owner(rid)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])&&request.resource.data.read is bool;allow delete: if owner(rid);
   }
  }
 }
}
